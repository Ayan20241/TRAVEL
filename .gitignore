# --- TourFlow AI .gitignore ---
# Secrets & env
.env
.env.*
!.env.example
*.pem
*.key

# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
.pytest_cache/
.coverage
htmlcov/

# Node / Next.js
node_modules/
.next/
out/
dist/
build/
*.tsbuildinfo

# OS / editors
.DS_Store
Thumbs.db
.idea/
.vscode/*
!.vscode/extensions.json

# Supabase
supabase/.branches/
supabase/.temp/

# Alembic
backend/alembic/versions/__pycache__/

# Logs
*.log
logs/
