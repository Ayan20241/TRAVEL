# ============================================================
# TourFlow AI — environment template
# Copy to .env (backend/) and NEVER commit real values.
# ============================================================

# ---------- Supabase ----------
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key   # backend only, NEVER exposed to browser
SUPABASE_JWT_SECRET=your-jwt-secret               # for local JWT verification fallback

# ---------- Database ----------
# Supabase Postgres (use the pooler URL in production)
DATABASE_URL=postgresql+psycopg2://postgres:password@db.your-project.supabase.co:5432/postgres

# ---------- Backend ----------
BACKEND_ENV=development            # development | staging | production
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
BACKEND_URL=http://localhost:8000
CORS_ORIGINS=http://localhost:3000
LOG_LEVEL=INFO

# ---------- Frontend ----------
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
NEXT_PUBLIC_BACKEND_URL=http://localhost:8000

# ---------- AI (optional; app works without it via deterministic fallback) ----------
AI_PROVIDER=none                   # none | openai | openrouter | anthropic
AI_API_KEY=
AI_MODEL=gpt-4o-mini
AI_BASE_URL=https://api.openai.com/v1
AI_TIMEOUT_SECONDS=25
